//@version=6
indicator("BD ZigZag MTF Consensus", shorttitle="ZZ-MTF", overlay=false, precision=0)

//══════════════════════════════════════════════════════════════════════════════
// INPUTS
//══════════════════════════════════════════════════════════════════════════════

grpDet = "ZigZag Detector"
devPct  = input.float(0.7, "Deviation %", minval=0.05, maxval=5.0, step=0.05, group=grpDet)
srcMode = input.string("High/Low", "Source", options=["High/Low", "Close"], group=grpDet)

grpTF = "Timeframes"
useTF1 = input.bool(true,  "Enable TF 1", inline="t1", group=grpTF)
tf1    = input.timeframe("1",   "",        inline="t1", group=grpTF)
useTF2 = input.bool(true,  "Enable TF 2", inline="t2", group=grpTF)
tf2    = input.timeframe("3",   "",        inline="t2", group=grpTF)
useTF3 = input.bool(true,  "Enable TF 3", inline="t3", group=grpTF)
tf3    = input.timeframe("5",   "",        inline="t3", group=grpTF)
useTF4 = input.bool(true,  "Enable TF 4", inline="t4", group=grpTF)
tf4    = input.timeframe("15",  "",        inline="t4", group=grpTF)
useTF5 = input.bool(true,  "Enable TF 5", inline="t5", group=grpTF)
tf5    = input.timeframe("30",  "",        inline="t5", group=grpTF)
useTF6 = input.bool(true,  "Enable TF 6", inline="t6", group=grpTF)
tf6    = input.timeframe("60",  "",        inline="t6", group=grpTF)
useTF7 = input.bool(true,  "Enable TF 7", inline="t7", group=grpTF)
tf7    = input.timeframe("240", "",        inline="t7", group=grpTF)
useTF8 = input.bool(true,  "Enable TF 8", inline="t8", group=grpTF)
tf8    = input.timeframe("D",   "",        inline="t8", group=grpTF)

grpVis = "Visual"
showLabels    = input.bool(true, "Show TF Labels (table)", group=grpVis)
upColor       = input.color(#00e676, "Up Color (after swing low)",  group=grpVis)
dnColor       = input.color(#ff4757, "Down Color (after swing high)", group=grpVis)
neutColor     = input.color(#2a2f3c, "Neutral / Init", group=grpVis)

//══════════════════════════════════════════════════════════════════════════════
// ZIGZAG DIRECTION — state machine computed per bar
// request.security evaluates this on each TF's own OHLC
// Returns: +1 = UP (after swing LOW), -1 = DOWN (after swing HIGH), 0 = init
//══════════════════════════════════════════════════════════════════════════════

dv = devPct / 100.0
useHL = srcMode == "High/Low"

float pH = useHL ? high : close
float pL = useHL ? low  : close

var int    zzDir = 0
var float  zzH   = high
var float  zzL   = low

if zzDir == 0
    if pH > zzL * (1.0 + dv)
        zzDir := 1
        zzH := pH
    else if pL < zzH * (1.0 - dv)
        zzDir := -1
        zzL := pL
    else
        if pH > zzH
            zzH := pH
        if pL < zzL
            zzL := pL
else if zzDir == 1
    if pH > zzH
        zzH := pH
    else if pL < zzH * (1.0 - dv)
        zzDir := -1
        zzL := pL
else if zzDir == -1
    if pL < zzL
        zzL := pL
    else if pH > zzL * (1.0 + dv)
        zzDir := 1
        zzH := pH

int zzDirOut = zzDir

//══════════════════════════════════════════════════════════════════════════════
// MULTI-TF DIRECTION FETCH — 8 request.security calls
//══════════════════════════════════════════════════════════════════════════════

d1 = useTF1 ? request.security(syminfo.tickerid, tf1, zzDirOut, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_off) : na
d2 = useTF2 ? request.security(syminfo.tickerid, tf2, zzDirOut, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_off) : na
d3 = useTF3 ? request.security(syminfo.tickerid, tf3, zzDirOut, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_off) : na
d4 = useTF4 ? request.security(syminfo.tickerid, tf4, zzDirOut, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_off) : na
d5 = useTF5 ? request.security(syminfo.tickerid, tf5, zzDirOut, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_off) : na
d6 = useTF6 ? request.security(syminfo.tickerid, tf6, zzDirOut, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_off) : na
d7 = useTF7 ? request.security(syminfo.tickerid, tf7, zzDirOut, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_off) : na
d8 = useTF8 ? request.security(syminfo.tickerid, tf8, zzDirOut, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_off) : na

//══════════════════════════════════════════════════════════════════════════════
// CONSENSUS
//══════════════════════════════════════════════════════════════════════════════

int nUp = 0
int nDn = 0
int nActive = 0

if not na(d1)
    nActive += 1
    nUp += d1 > 0 ? 1 : 0
    nDn += d1 < 0 ? 1 : 0
if not na(d2)
    nActive += 1
    nUp += d2 > 0 ? 1 : 0
    nDn += d2 < 0 ? 1 : 0
if not na(d3)
    nActive += 1
    nUp += d3 > 0 ? 1 : 0
    nDn += d3 < 0 ? 1 : 0
if not na(d4)
    nActive += 1
    nUp += d4 > 0 ? 1 : 0
    nDn += d4 < 0 ? 1 : 0
if not na(d5)
    nActive += 1
    nUp += d5 > 0 ? 1 : 0
    nDn += d5 < 0 ? 1 : 0
if not na(d6)
    nActive += 1
    nUp += d6 > 0 ? 1 : 0
    nDn += d6 < 0 ? 1 : 0
if not na(d7)
    nActive += 1
    nUp += d7 > 0 ? 1 : 0
    nDn += d7 < 0 ? 1 : 0
if not na(d8)
    nActive += 1
    nUp += d8 > 0 ? 1 : 0
    nDn += d8 < 0 ? 1 : 0

int netCons = nUp - nDn

//══════════════════════════════════════════════════════════════════════════════
// VISUAL: TF DIRECTION BANDS — steplines at fixed levels, colored by direction
// Layout:  Levels 1-8 = TF bands (top half)
//          Level 0 = zero line
//          Levels -1 to -8 = consensus histogram (bottom half, mirrored)
//══════════════════════════════════════════════════════════════════════════════

// Helper: direction → color
f_dc(int d) =>
    d > 0 ? upColor : d < 0 ? dnColor : neutColor

// TF bands at levels 1–8: plot as stepline, colored by direction
// Each plot sits at its own level so no overlap
plot(not na(d1) ? 1  : na, "TF1 Band", f_dc(d1), style=plot.style_stepline_diamond, linewidth=3)
plot(not na(d2) ? 2  : na, "TF2 Band", f_dc(d2), style=plot.style_stepline_diamond, linewidth=3)
plot(not na(d3) ? 3  : na, "TF3 Band", f_dc(d3), style=plot.style_stepline_diamond, linewidth=3)
plot(not na(d4) ? 4  : na, "TF4 Band", f_dc(d4), style=plot.style_stepline_diamond, linewidth=3)
plot(not na(d5) ? 5  : na, "TF5 Band", f_dc(d5), style=plot.style_stepline_diamond, linewidth=3)
plot(not na(d6) ? 6  : na, "TF6 Band", f_dc(d6), style=plot.style_stepline_diamond, linewidth=3)
plot(not na(d7) ? 7  : na, "TF7 Band", f_dc(d7), style=plot.style_stepline_diamond, linewidth=3)
plot(not na(d8) ? 8  : na, "TF8 Band", f_dc(d8), style=plot.style_stepline_diamond, linewidth=3)

// Zero line
hline(0, "Zero", color.new(#5a6275, 50), linestyle=hline.style_solid)

// Consensus histogram below zero: net value as colored column
color consBarColor = netCons > 0 ? color.new(upColor, 30) : netCons < 0 ? color.new(dnColor, 30) : color.new(neutColor, 30)
plot(netCons, "Consensus", consBarColor, style=plot.style_histogram, linewidth=5)

// Background flash on full alignment
bool fullUp = nUp == nActive and nActive >= 3
bool fullDn = nDn == nActive and nActive >= 3
bgcolor(fullUp ? color.new(upColor, 88) : fullDn ? color.new(dnColor, 88) : na, title="Full Alignment BG")

//══════════════════════════════════════════════════════════════════════════════
// SIGNAL MARKERS
//══════════════════════════════════════════════════════════════════════════════

bool alignUp = fullUp and not fullUp[1]
bool alignDn = fullDn and not fullDn[1]
bool flipUp  = netCons > 0 and netCons[1] <= 0 and nActive >= 3
bool flipDn  = netCons < 0 and netCons[1] >= 0 and nActive >= 3

plotshape(alignUp, "★ Full UP",   shape.triangleup,   location.absolute, color.new(upColor, 0), offset=0, size=size.small, text="ALL↑")
plotshape(alignDn, "★ Full DOWN", shape.triangledown, location.absolute, color.new(dnColor, 0), offset=0, size=size.small, text="ALL↓")

//══════════════════════════════════════════════════════════════════════════════
// INFO TABLE — TF labels + direction on last bar
//══════════════════════════════════════════════════════════════════════════════

if barstate.islast and showLabels
    var table tbl = table.new(position.top_right, 3, 10,
         bgcolor=color.new(#0a0c10, 10), border_width=1, border_color=color.new(#2a2f3c, 0))

    table.cell(tbl, 0, 0, "TF",  text_color=#8b93a6, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 0, "Dir", text_color=#8b93a6, text_size=size.tiny, text_halign=text.align_center)
    table.cell(tbl, 2, 0, "#",   text_color=#8b93a6, text_size=size.tiny, text_halign=text.align_center)

    allTFs   = array.from(tf1, tf2, tf3, tf4, tf5, tf6, tf7, tf8)
    allDirs  = array.from(d1, d2, d3, d4, d5, d6, d7, d8)
    allOn    = array.from(useTF1?1:0, useTF2?1:0, useTF3?1:0, useTF4?1:0, useTF5?1:0, useTF6?1:0, useTF7?1:0, useTF8?1:0)

    int row = 1
    for i = 0 to 7
        if array.get(allOn, i) == 1
            int dd = array.get(allDirs, i)
            if not na(dd)
                string tfL = array.get(allTFs, i)
                string dS  = dd > 0 ? "▲ UP" : dd < 0 ? "▼ DN" : "—"
                color dC   = dd > 0 ? upColor : dd < 0 ? dnColor : neutColor
                table.cell(tbl, 0, row, tfL, text_color=#e8eaf0, text_size=size.tiny, text_halign=text.align_left)
                table.cell(tbl, 1, row, dS,  text_color=dC,      text_size=size.tiny, text_halign=text.align_center)
                table.cell(tbl, 2, row, str.tostring(row), text_color=#5a6275, text_size=size.tiny, text_halign=text.align_center)
                row += 1

    // Summary row
    string sumS = str.tostring(nUp) + "↑ " + str.tostring(nDn) + "↓"
    color sumC  = nUp > nDn ? upColor : nUp < nDn ? dnColor : #8b93a6
    table.cell(tbl, 0, row, "SUM", text_color=#ffd740, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, row, sumS,  text_color=sumC,    text_size=size.tiny, text_halign=text.align_center)
    table.cell(tbl, 2, row, str.tostring(nActive), text_color=#5a6275, text_size=size.tiny, text_halign=text.align_center)

//══════════════════════════════════════════════════════════════════════════════
// ALERTS
//══════════════════════════════════════════════════════════════════════════════

alertcondition(alignUp, "Full Align UP",   "All ZZ timeframes aligned UP")
alertcondition(alignDn, "Full Align DOWN", "All ZZ timeframes aligned DOWN")
alertcondition(flipUp,  "Flip to UP",      "ZZ consensus flipped bullish")
alertcondition(flipDn,  "Flip to DOWN",    "ZZ consensus flipped bearish")
