{
  "manifest_version": 3,
  "name": "AI za OmniCPQ",
  "version": "1.0.0",
  "minimum_chrome_version": "110",
  "description": "DEMO: lokalna minimizacija; STAGE branje in navigacija. Cene, slike, priloge in poslovni vnosi so izključeni.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "debugger"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "AI za OmniCPQ · DEMO",
    "default_popup": "popup.html"
  },
  "icons": {
    "32": "icon-32.png"
  },
  "externally_connectable": {
    "matches": [
      "https://www.mdlxdcc.org/omnicpq/demo/*"
    ]
  }
}
