{
  "manifest_version": 3,
  "name": "OmniCPQ · povezava",
  "version": "1.2.5",
  "minimum_chrome_version": "110",
  "description": "Poveže izbrani CPQ zavihek s standalone pomočnikom: vidni GUI, miška, tipkovnica, obrazci in večkorakovno delo po potrditvi.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "debugger"
  ],
  "background": {
    "service_worker": "worker-v2.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "OmniCPQ · povezava",
    "default_popup": "popup.html"
  },
  "icons": {
    "32": "icon-32.png"
  },
  "externally_connectable": {
    "matches": [
      "https://www.mdlxdcc.org/*"
    ]
  }
}
