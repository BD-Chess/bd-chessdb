# 8zTSP in your browser at /8zTSP/ (BD x AI Lab, 15 Nov 2026): cross-origin isolation only for the demo and its own
# files, so that its workers can share memory (SharedArrayBuffer). Netlify matches header paths regardless of case.
/8zTSP
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/8zTSP/
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/8zTSP/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff

# 8zTSP as an app (R22b): the service worker, its file list and the manifest are always checked for a new version
/8zTSP/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /8zTSP/

/8zTSP/precache-manifest.json
  Cache-Control: no-cache

/8zTSP/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Carbon R2 uses a dedicated Web Worker and a WebAssembly module.
