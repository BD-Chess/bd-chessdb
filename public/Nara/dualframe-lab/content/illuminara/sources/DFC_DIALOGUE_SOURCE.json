{
  "schema": "bd.dfc.dialogue-source.v1",
  "version": "R1",
  "story_id": "ILLUMINARA_TEZA_SVETLOBE_01",
  "records": [
    {
      "text_id": "P01-K01-T01",
      "kind": "SFX",
      "speaker": "",
      "order": 1,
      "SL": "KRAK!",
      "EN": "KRAK!"
    },
    {
      "text_id": "P01-K02-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Primite se!",
      "EN": "Hold on!"
    },
    {
      "text_id": "P01-K03-T01",
      "kind": "SPEECH",
      "speaker": "Helion",
      "order": 1,
      "SL": "Imam ga!",
      "EN": "I've got it!"
    },
    {
      "text_id": "P01-K04-T01",
      "kind": "SFX",
      "speaker": "",
      "order": 1,
      "SL": "KRRR...",
      "EN": "KRRR..."
    },
    {
      "text_id": "P01-K06-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Helion! Ne dviguj!",
      "EN": "Helion! Don't lift!"
    },
    {
      "text_id": "P01-K06-T02",
      "kind": "SPEECH",
      "speaker": "Helion",
      "order": 2,
      "SL": "Zakaj?",
      "EN": "Why?"
    },
    {
      "text_id": "P01-K06-T03",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 3,
      "SL": "Vagon se trga.",
      "EN": "The carriage is tearing."
    },
    {
      "text_id": "P02-K01-T01",
      "kind": "SPEECH",
      "speaker": "Helion",
      "order": 1,
      "SL": "Niti za centimeter?",
      "EN": "Not even a centimetre?"
    },
    {
      "text_id": "P02-K02-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Drži. Samo drži.",
      "EN": "Hold it. Just hold it."
    },
    {
      "text_id": "P02-K04-T01",
      "kind": "SPEECH",
      "speaker": "Driver",
      "order": 1,
      "SL": "Prečni nosilci. Pod vsakimi drugimi vrati.",
      "EN": "The crossbeams. Under every other door."
    },
    {
      "text_id": "P02-K05-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Pokažite mi naslednjega.",
      "EN": "Show me the next one."
    },
    {
      "text_id": "P03-K02-T01",
      "kind": "SPEECH",
      "speaker": "Driver",
      "order": 1,
      "SL": "Vleče še zadnjega.",
      "EN": "It's pulling the other car."
    },
    {
      "text_id": "P03-K03-T01",
      "kind": "SPEECH",
      "speaker": "Helion",
      "order": 1,
      "SL": "Lahko jo odtrgam.",
      "EN": "I can tear it apart."
    },
    {
      "text_id": "P03-K04-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Brez sunka.",
      "EN": "No sudden moves."
    },
    {
      "text_id": "P03-K04-T02",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 2,
      "SL": "Imamo ročni odklop?",
      "EN": "Is there a manual release?"
    },
    {
      "text_id": "P03-K05-T01",
      "kind": "SPEECH",
      "speaker": "Driver",
      "order": 1,
      "SL": "Imamo. Najprej jo razbremenita.",
      "EN": "Yes. First, take the strain off the coupling."
    },
    {
      "text_id": "P04-K02-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Glejte podest. Počasi, drug za drugim.",
      "EN": "Watch the platform. Slowly, one at a time."
    },
    {
      "text_id": "P04-K04-T01",
      "kind": "SPEECH",
      "speaker": "Helion",
      "order": 1,
      "SL": "Illuminara?",
      "EN": "Illuminara?"
    },
    {
      "text_id": "P04-K05-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Še lahko. Spravi jih čez.",
      "EN": "I can still do this. Get them across."
    },
    {
      "text_id": "P05-K02-T01",
      "kind": "SFX",
      "speaker": "",
      "order": 1,
      "SL": "DONG!",
      "EN": "DONG!"
    },
    {
      "text_id": "P05-K03-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Naprej!",
      "EN": "Keep moving!"
    },
    {
      "text_id": "P05-K04-T01",
      "kind": "SPEECH",
      "speaker": "Helion",
      "order": 1,
      "SL": "Ne moreš držati vsega.",
      "EN": "You can't hold everything."
    },
    {
      "text_id": "P06-K02-T01",
      "kind": "SPEECH",
      "speaker": "Driver",
      "order": 1,
      "SL": "Če se poravna, gre.",
      "EN": "If it lines up, it will release."
    },
    {
      "text_id": "P06-K03-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Spusti prednji del. Počasi.",
      "EN": "Lower the front end. Slowly."
    },
    {
      "text_id": "P06-K04-T01",
      "kind": "SPEECH",
      "speaker": "Helion",
      "order": 1,
      "SL": "Koliko?",
      "EN": "How much?"
    },
    {
      "text_id": "P06-K05-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Trideset centimetrov. Na moj znak.",
      "EN": "Thirty centimetres. On my signal."
    },
    {
      "text_id": "P07-K01-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Zdaj.",
      "EN": "Now."
    },
    {
      "text_id": "P07-K02-T01",
      "kind": "SFX",
      "speaker": "",
      "order": 1,
      "SL": "KLIK.",
      "EN": "CLICK."
    },
    {
      "text_id": "P08-K02-T01",
      "kind": "SPEECH",
      "speaker": "Helion",
      "order": 1,
      "SL": "Mislil sem, da ga lahko zadržim sam.",
      "EN": "I thought I could hold it alone."
    },
    {
      "text_id": "P08-K03-T01",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 1,
      "SL": "Saj si ga. Zato smo imeli čas.",
      "EN": "You did. That bought us time."
    },
    {
      "text_id": "P08-K04-T01",
      "kind": "SPEECH",
      "speaker": "Helion",
      "order": 1,
      "SL": "In zdaj?",
      "EN": "And now?"
    },
    {
      "text_id": "P08-K04-T02",
      "kind": "SPEECH",
      "speaker": "Illuminara",
      "order": 2,
      "SL": "Zdaj pa pet minut sediva.",
      "EN": "Now we sit for five minutes."
    }
  ],
