{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AndaluzijaTripOptiV1 mutation request",
  "interfaceVersion": "1.0.0",
  "global": "window.AndaluzijaTripOptiV1",
  "methods": {
    "getState": {
      "args": [],
      "returns": "planner projection without preferences, secrets or private content"
    },
    "getContext": {
      "args": [],
      "returns": "selected POIs only; capability flags"
    },
    "previewChanges": {
      "args": [
        "operations",
        "baseRevision"
      ],
      "effect": "none",
      "returns": "preview with concrete diff"
    },
    "optimizeDay": {
      "args": [
        "options"
      ],
      "effect": "none",
      "options": {
        "mode": [
          "estimate",
          "walking"
        ],
        "segment": "zero based untimed segment",
        "progress": "optional callback"
      },
      "returns": "preview with IDs, receipt, memory-only metrics"
    },
    "cancelOptimization": {
      "args": []
    },
    "applyChanges": {
      "args": [
        "operations",
        "baseRevision",
        "requestId"
      ],
      "effect": "applied_local; server auth required; call save for acknowledgement"
    },
    "save": {
      "args": [],
      "effect": "saved only on server acknowledgement; otherwise throws or synced"
    },
    "sync": {
      "args": [],
      "effect": "strong read or conflict"
    },
    "undoLastOwnChange": {
      "args": [],
      "effect": "revision guarded own undo"
    },
    "mapsForStop": {
      "args": [
        "id"
      ],
      "returns": [
        "place",
        "walk"
      ]
    },
    "mapsForLeg": {
      "args": [
        "a",
        "b"
      ],
      "returns": "Google Maps walking URL"
    }
  },
  "type": "object",
  "required": [
    "operations",
    "baseRevision",
    "requestId"
  ],
  "additionalProperties": false,
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,100}$"
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "status"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "status": {
          "enum": [
            "unresolved",
            "approximate",
            "confirmed"
          ]
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "placeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,300}$"
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "city",
        "name",
        "durationMin",
        "enabled",
        "fixedTime",
        "location"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,90}$"
        },
        "city": {
          "enum": [
            "malaga",
            "nerja",
            "granada",
            "cordoba",
            "carmona",
            "sevilla",
            "setenil",
            "ronda",
            "marbella",
            "mijas"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "durationMin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 720
        },
        "enabled": {
          "type": "boolean"
        },
        "fixedTime": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "optional": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "checked": {
          "type": "string"
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "variant",
            "day",
            "city",
            "stops"
          ],
          "properties": {
            "type": {
              "const": "replaceStops"
            },
            "variant": {
              "enum": [
                "mateja",
                "claude",
                "gpt"
              ]
            },
            "day": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "city": {
              "enum": [
                "malaga",
                "nerja",
                "granada",
                "cordoba",
                "carmona",
                "sevilla",
                "setenil",
                "ronda",
                "marbella",
                "mijas"
              ]
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/stop"
              },
              "maxItems": 49
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "variant",
            "day",
            "city",
            "id",
            "patch"
          ],
          "properties": {
            "type": {
              "const": "patchStop"
            },
            "variant": {
              "enum": [
                "mateja",
                "claude",
                "gpt"
              ]
            },
            "day": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "city": {
              "enum": [
                "malaga",
                "nerja",
                "granada",
                "cordoba",
                "carmona",
                "sevilla",
                "setenil",
                "ronda",
                "marbella",
                "mijas"
              ]
            },
            "id": {
              "type": "string"
            },
            "patch": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "durationMin": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 720
                },
                "enabled": {
                  "type": "boolean"
                },
                "fixedTime": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "location": {
                  "$ref": "#/$defs/location"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "variant",
            "day",
            "city",
            "ids"
          ],
          "properties": {
            "type": {
              "const": "reorder"
            },
            "variant": {
              "enum": [
                "mateja",
                "claude",
                "gpt"
              ]
            },
            "day": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "city": {
              "enum": [
                "malaga",
                "nerja",
                "granada",
                "cordoba",
                "carmona",
                "sevilla",
                "setenil",
                "ronda",
                "marbella",
                "mijas"
              ]
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true,
              "maxItems": 49
            },
            "origin": {
              "enum": [
                "manual",
                "deep"
              ]
            },
            "receipt": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "variant",
            "day",
            "city",
            "minutes"
          ],
          "properties": {
            "type": {
              "const": "setBreak"
            },
            "variant": {
              "enum": [
                "mateja",
                "claude",
                "gpt"
              ]
            },
            "day": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "city": {
              "enum": [
                "malaga",
                "nerja",
                "granada",
                "cordoba",
                "carmona",
                "sevilla",
                "setenil",
                "ronda",
                "marbella",
                "mijas"
              ]
            },
            "minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 480
            }
          }
        }
      ]
    }
  },
  "invariants": [
    "Mutation scope equals selected variant/day/city",
    "Existing fixed-time events retain their positions during reorder/replace",
    "No booking/accommodation mutations",
    "No private context harvesting",
    "Google provider data stays in memory; place IDs and user selections may persist",
    "No paid call on typing or page load"
  ]
}
