# Place real values in your host's managed secrets/environment, never in Git.
# This file is documentation. server.py does not automatically load .env files.
DUALFRAME_INVITE_TOKENS=REPLACE_WITH_RANDOM_32_PLUS_CHAR_INVITE
DUALFRAME_DATA_DIR=/private/dualframe-data
DUALFRAME_ALLOWED_ORIGINS=https://bd-chess.github.io,http://127.0.0.1:8765,http://localhost:8765
DUALFRAME_TTL_SECONDS=86400

# ALL real-provider gates stay closed until account/entitlement/privacy review.
DUALFRAME_LIVE_ENABLED=0
DUALFRAME_FREE_ENTITLEMENT_VERIFIED=0
DUALFRAME_RETENTION_REVIEWED=0
DUALFRAME_VERIFIED_FREE_REQUESTS=0
BRIA_API_TOKEN=
# Exact provider output host(s), inspected and approved for this account.
# No wildcard domains, user-provided fetch URLs or public upload are accepted.
BRIA_ASSET_HOSTS=
